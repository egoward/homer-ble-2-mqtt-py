# This file is generated by setup.sh with the correct paths for your installation.
# Run setup.sh first, then: sudo cp ble2mqtt.service /etc/systemd/system/
[Unit]
Description=BLE to MQTT
After=multi-user.target

[Service]
Type=simple
Restart=always
ExecStart=/path/to/homer-ble-2-mqtt-py/venv/bin/python3 /path/to/homer-ble-2-mqtt-py/ble2mqtt.py

[Install]
WantedBy=multi-user.target